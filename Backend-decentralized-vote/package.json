{
  "name": "votesecure-backend",
  "version": "1.0.0",
  "description": "VoteSecure — Decentralized Civic Voting Platform Backend (Express Gateway)",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon --watch '**/*.js' --ext js index.js",
    "build": "echo 'No build step for ESM'",
    "lint": "eslint . --ext .js",
    "format": "prettier --write '**/*.js'",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.10.1",
    "@prisma/client": "^6.10.1",
    "@sentry/node": "^8.53.0",
    "axios": "^1.7.9",
    "bullmq": "^5.71.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.4.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.16.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^5.0.3",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.2",
    "prisma": "^6.10.1",
    "supertest": "^7.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
