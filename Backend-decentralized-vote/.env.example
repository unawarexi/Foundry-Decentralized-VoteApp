# ============================================================
# VoteSecure — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=VoteSecure
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/votesecure

# ── Firebase Admin ───────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your_very_long_random_secret_at_least_64_chars
JWT_EXPIRY=7d

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Kafka ────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=votesecure-backend
KAFKA_GROUP_ID=votesecure-consumer

# ── Blockchain (ethers.js v6) ─────────────────────────────────
BLOCKCHAIN_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
BLOCKCHAIN_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
BLOCKCHAIN_CHAIN_ID=137
ALCHEMY_API_KEY=your_alchemy_api_key
INFURA_API_KEY=your_infura_api_key

# ── Smart Contract Addresses (UUPS Proxies) ───────────────────
CONTRACT_IDENTITY_REGISTRY=0x0000000000000000000000000000000000000000
CONTRACT_REGION_REGISTRY=0x0000000000000000000000000000000000000000
CONTRACT_ELECTION_FACTORY=0x0000000000000000000000000000000000000000
CONTRACT_VOTE_PROTOCOL=0x0000000000000000000000000000000000000000
CONTRACT_VOTE_FEE_ESCROW=0x0000000000000000000000000000000000000000
CONTRACT_CANDIDATE_REGISTRY=0x0000000000000000000000000000000000000000
CONTRACT_PARTY_REGISTRY=0x0000000000000000000000000000000000000000
CONTRACT_FORUM_GOVERNANCE=0x0000000000000000000000000000000000000000
CONTRACT_FRAUD_DETECTION=0x0000000000000000000000000000000000000000
CONTRACT_ZK_VERIFIER=0x0000000000000000000000000000000000000000

# ── Payment Tokens ───────────────────────────────────────────
VOTE_FEE_USD_CENTS=100
USDT_CONTRACT_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
USDC_CONTRACT_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# ── IPFS / Filecoin ───────────────────────────────────────────
IPFS_API_URL=https://api.web3.storage
IPFS_GATEWAY_URL=https://w3s.link
WEB3_STORAGE_TOKEN=your_web3_storage_token

# ── GeoIP ────────────────────────────────────────────────────
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb
ENFORCE_REGION_LOCK=true

# ── FastAPI AI Service ────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_API_KEY=your_internal_ai_api_key

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="VoteSecure <noreply@votesecure.io>"

# ── Cloudinary (profile images) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Sentry ────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/0

# ── Prometheus ───────────────────────────────────────────────
PROMETHEUS_METRICS_PORT=9090

# ── BullMQ Dashboard ─────────────────────────────────────────
BULL_BOARD_USER=admin
BULL_BOARD_PASS=changeme
