# ── Foundry build artifacts ───────────────────────────────────────────────────
cache/
out/

# ── Deployment broadcast logs (keep only production; exclude local/dry-runs) ──
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Foundry dependencies (re-installed via `forge install`) ───────────────────
lib/

# ── Coverage & gas reports ────────────────────────────────────────────────────
lcov.info
.gas-snapshot

# ── Hardhat / other tooling artifacts (if ever co-located) ───────────────────
node_modules/
artifacts/
typechain/
typechain-types/

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverrideDirectory

# ── Docs (generated) ──────────────────────────────────────────────────────────
docs/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log

# ── Python / static-analysis tooling ─────────────────────────────────────────
__pycache__/
*.py[cod]
.slither/
.mythril/
